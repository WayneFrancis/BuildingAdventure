<Window x:Class="BuildingAdventure.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildingAdventure.Desktop.Controls"
        Title="BuildingAdventure" Width="1250" Height="820"
        MinWidth="850" MinHeight="560" WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Click="SaveAs_Click" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenu" Header="_Undo" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="RedoMenu" Header="_Redo" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Remove selected corner (join walls)" Click="Delete_Click" InputGestureText="Delete"/>
                <MenuItem Header="Delete selected room" Click="DeleteRoom_Click"/>
                <MenuItem Header="Delete selected door" Click="DeleteDoor_Click"/>
                <MenuItem Header="Cancel drawing" Click="Cancel_Click" InputGestureText="Esc"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Fit to window" Click="Fit_Click" InputGestureText="Ctrl+0"/>
                <MenuItem Header="Zoom in" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom out" Click="ZoomOut_Click"/>
            </MenuItem>
        </Menu>
        <ToolBar DockPanel.Dock="Top" Background="#F0F2F5">
            <Button Content="New" Click="New_Click" Padding="9,4"/>
            <Button Content="Open" Click="Open_Click" Padding="9,4"/>
            <Button Content="Save" Click="Save_Click" Padding="9,4"/>
            <Separator/>
            <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Padding="9,4"/>
            <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" Padding="9,4"/>
            <Separator/>
            <Button x:Name="SelectButton" Content="Select / Edit" Click="SelectTool_Click" Padding="9,4"/>
            <Button x:Name="DrawButton" Content="Draw Perimeter" Click="DrawTool_Click" Padding="9,4"/>
            <Button x:Name="SplitButton" Content="Split Perimeter" Click="SplitPerimeter_Click" Padding="9,4"/>
            <Button x:Name="RemoveCornerButton" Content="Remove Corner" Click="RemoveCornerTool_Click" Padding="9,4"/>
            <Button x:Name="RoomButton" Content="Draw Room" Click="RoomTool_Click" Padding="9,4"/>
            <Button x:Name="SplitRoomButton" Content="Split Room" Click="SplitRoomTool_Click" Padding="9,4"/>
            <Button x:Name="MergeRoomsButton" Content="Merge Rooms" Click="MergeRoomsTool_Click" Padding="9,4"/>
            <Button x:Name="MoveWallButton" Content="Move Wall" Click="MoveWallTool_Click" Padding="9,4"/>
            <Button x:Name="DoorButton" Content="Add Door" Click="DoorTool_Click" Padding="9,4"/>
            <Button x:Name="WindowButton" Content="Add Window" Click="WindowTool_Click" Padding="9,4"/>
            <Button x:Name="PlaceStairsButton" Content="Place Stairs" Click="PlaceStairsTool_Click" Padding="9,4"/>
            <Button x:Name="PanButton" Content="Pan" Click="PanTool_Click" Padding="9,4"/>
            <Separator/>
            <Button Content="Fit" Click="Fit_Click" Padding="9,4"/>
            <Button Content="+" Click="ZoomIn_Click" Padding="9,4"/>
            <Button Content="−" Click="ZoomOut_Click" Padding="9,4"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom" Background="#E9EDF2">
            <StatusBarItem>
                <TextBlock x:Name="HintText" Text="Ready."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="100%" />
            </StatusBarItem>
        </StatusBar>
        <Border DockPanel.Dock="Right" Width="286" Background="#F7F8FA"
                BorderBrush="#D9DEE6" BorderThickness="1,0,0,0">
            <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <Expander x:Name="BuildingSection" Header="BUILDING" IsExpanded="True"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Map visibility" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="MapModeBox" SelectedIndex="0" SelectionChanged="MapModeChanged"
                              Margin="0,0,0,12" Padding="5">
                        <ComboBoxItem Content="Editor"/>
                        <ComboBoxItem Content="Game Master"/>
                        <ComboBoxItem Content="Player preview"/>
                    </ComboBox>
                    <TextBlock Text="Building name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" Text="Untitled Building" TextChanged="NameBox_TextChanged"
                             GotKeyboardFocus="NameBox_GotKeyboardFocus"
                             LostKeyboardFocus="NameBox_LostKeyboardFocus"
                             Padding="7" Margin="0,0,0,14"/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="FloorsSection" Header="FLOORS" IsExpanded="True"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <ComboBox x:Name="FloorPicker" SelectionChanged="FloorPicker_SelectionChanged"
                              Padding="5" Margin="0,0,0,9"/>
                    <TextBlock Text="ALIGN ADJACENT FLOORS" FontSize="11"
                               FontWeight="Bold" Foreground="#566579" Margin="0,4,0,7"/>
                    <WrapPanel Margin="0,0,0,7">
                        <CheckBox x:Name="ShowBelowCheckBox" Content="Below" Margin="0,0,15,0"
                                  Checked="AlignmentChanged" Unchecked="AlignmentChanged"/>
                        <CheckBox x:Name="ShowAboveCheckBox" Content="Above"
                                  Checked="AlignmentChanged" Unchecked="AlignmentChanged"/>
                    </WrapPanel>
                    <CheckBox x:Name="AllFloorSilhouettesCheckBox"
                              Content="Show silhouettes of every other floor"
                              Checked="AlignmentChanged" Unchecked="AlignmentChanged"
                              Margin="0,0,0,7"/>
                    <TextBlock Text="Reference visibility" Margin="0,0,0,4"
                               Foreground="#566579"/>
                    <Slider x:Name="AlignmentOpacitySlider" Minimum="0.15" Maximum="0.85"
                            Value="0.45" TickFrequency="0.1" IsSnapToTickEnabled="False"
                            ValueChanged="AlignmentOpacityChanged"
                            Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="AddFloorButton" Content="Add Floor" Click="AddFloor_Click"
                                Padding="7,5" Margin="0,0,7,0"/>
                        <Button x:Name="RemoveFloorButton" Content="Delete Selected Floor"
                                Click="RemoveFloor_Click" Padding="7,5"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="AddBasementButton" Content="Add Basement" Click="AddBasement_Click"
                                Padding="7,5" Margin="0,0,7,0"/>
                        <TextBlock Text="Select any floor above, then choose Delete Selected Floor."
                                   Foreground="#566579" TextWrapping="Wrap"/>
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#566579" Margin="0,0,0,14"
                               Text="Select any level and choose Delete Selected Floor. Floors above it move down one elevation; stair flights directly connected to the deleted floor are removed after confirmation. A basement-only building is allowed. Page Up and Page Down navigate levels."/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="GeneratorSection" Header="GENERATOR / SUGGESTIONS"
                              IsExpanded="False" Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="#566579"
                                       Text="Complete checked existing floors, or create a new whole building below. Green previews include rooms, doors, windows and stairs. Nothing changes until Accept All."
                                       Margin="0,0,0,8"/>
                            <TextBlock FontWeight="SemiBold" Text="Building purpose" Margin="0,0,0,5"/>
                            <ComboBox x:Name="GeneratorPurposeBox" Padding="5" SelectedIndex="0"
                                      Margin="0,0,0,12">
                                <ComboBoxItem Content="Residence"/>
                                <ComboBoxItem Content="Inn or tavern"/>
                                <ComboBoxItem Content="Shop or workshop"/>
                                <ComboBoxItem Content="Dungeon"/>
                                <ComboBoxItem Content="Mixed use"/>
                            </ComboBox>
                            <TextBlock FontWeight="SemiBold" Text="Generate features" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox x:Name="GenerateRoomsCheckBox" Content="Rooms" IsChecked="True" Margin="0,0,12,6"/>
                                <CheckBox x:Name="GenerateCorridorsCheckBox" Content="Corridors" IsChecked="True" Margin="0,0,12,6"/>
                                <CheckBox x:Name="GenerateDoorsCheckBox" Content="Doors" IsChecked="True" Margin="0,0,12,6"/>
                                <CheckBox x:Name="GenerateWindowsCheckBox" Content="Windows" Margin="0,0,12,6"/>
                                <CheckBox x:Name="GenerateStairsCheckBox" Content="Stairs" Margin="0,0,12,6"/>
                            </WrapPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#566579" Margin="0,0,0,8"
                                       Text="Rooms are arranged beside a corridor when one can fit. Doors use actual shared walls. Windows and stairs are optional; stair flights require both adjoining floors checked. Every candidate is validated before preview."/>
                            <TextBlock FontWeight="SemiBold" Text="Existing floors to complete (does not add floors)" Margin="0,0,0,6"/>
                            <StackPanel x:Name="GeneratorFloorChecks" Margin="0,0,0,10"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Suggest on checked floors" Click="Suggest_Click"
                                        Padding="7,5" Margin="0,0,5,0"/>
                                <Button x:Name="AcceptSuggestionButton" Content="Accept All"
                                        Click="AcceptSuggestion_Click" IsEnabled="False" Padding="7,5"/>
                            </WrapPanel>
                            <Button x:Name="AcceptSuggestedRoomButton" Content="Accept selected suggested room"
                                    Click="AcceptSuggestedRoom_Click" IsEnabled="False"
                                    Padding="7,5" Margin="0,0,0,8"/>
                            <Button Content="View next selected floor" Click="NextSuggestedFloor_Click"
                                    Padding="7,5" Margin="0,0,0,7"/>
                            <Button x:Name="InspectProposalButton" Content="Inspect all proposed floors"
                                    Click="InspectProposal_Click" IsEnabled="False"
                                    Padding="7,5" Margin="0,0,0,7"/>
                            <TextBlock Text="New whole-building draft (1–4 floors)" FontWeight="SemiBold"
                                       Margin="0,10,0,5"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#566579" Margin="0,0,0,8"
                                       Text="Choose the total number of floors below and click Suggest entire building. All levels appear in the main plan preview, with its own floor selector and Previous/Next buttons. Accept All replaces your building; Discard preview leaves it unchanged."/>
                            <WrapPanel Margin="0,0,0,9">
                                <ComboBox x:Name="WholeBuildingFloorsBox" Width="85" SelectedIndex="1"
                                          Padding="4" Margin="0,0,5,0">
                                    <ComboBoxItem Content="1 floor"/>
                                    <ComboBoxItem Content="2 floors"/>
                                    <ComboBoxItem Content="3 floors"/>
                                    <ComboBoxItem Content="4 floors"/>
                                </ComboBox>
                                <Button Content="Suggest entire building" Click="SuggestWholeBuilding_Click"
                                        Padding="6,5"/>
                            </WrapPanel>
                            <TextBlock x:Name="SuggestionInfoText" Text="No pending suggestion."
                                       TextWrapping="Wrap" Foreground="#316D4B" Margin="0,0,0,10"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button x:Name="RememberSuggestionButton" Content="Remember"
                                        IsEnabled="False" Click="RememberSuggestion_Click"
                                        Padding="7,5" Margin="0,0,5,0"/>
                                <Button Content="Discard preview" Click="DiscardSuggestion_Click"
                                        Padding="7,5"/>
                            </WrapPanel>
                            <TextBlock Text="Saved candidates" FontWeight="SemiBold" Margin="0,8,0,5"/>
                            <ListBox x:Name="SuggestionMemoryList" MaxHeight="160" MinHeight="64"
                                     SelectionChanged="MemorySelectionChanged" Margin="0,0,0,7"/>
                            <WrapPanel>
                                <Button x:Name="RecallSuggestionButton" Content="Preview saved"
                                        IsEnabled="False" Click="RecallSuggestion_Click"
                                        Padding="6,5" Margin="0,0,5,5"/>
                                <Button x:Name="RemoveSuggestionButton" Content="Remove"
                                        IsEnabled="False" Click="RemoveSuggestion_Click"
                                        Padding="6,5" Margin="0,0,5,5"/>
                                <Button x:Name="ClearSuggestionsButton" Content="Clear list"
                                        Click="ClearSuggestions_Click" Padding="6,5" Margin="0,0,0,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="StaircasesSection" Header="STAIRCASES" IsExpanded="False"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <TextBlock x:Name="StairsText" Text="0 stair flights" Margin="0,0,0,8"/>
                    <TextBlock Text="Stair flights touching this floor" Margin="0,0,0,5"/>
                    <ComboBox x:Name="StairFlightPicker" Padding="5" Margin="0,0,0,10"
                              SelectionChanged="StairFlightPicker_SelectionChanged"/>
                    <TextBlock x:Name="OpeningText" Text="0 stairwell openings above ground"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Length (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairLengthBox" Text="3.6" Padding="5" Margin="0,0,0,8"
                             TextChanged="StairSettingsChanged"/>
                    <TextBlock Text="Width (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairWidthBox" Text="1.4" Padding="5" Margin="0,0,0,8"
                             TextChanged="StairSettingsChanged"/>
                    <TextBlock Text="Extra stairwell opening width (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="OpeningWidthBox" Text="0" Padding="5"
                             TextChanged="StairSettingsChanged" Margin="0,0,0,8"/>
                    <TextBlock Text="Extra stairwell opening length (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="OpeningLengthBox" Text="0" Padding="5"
                             TextChanged="StairSettingsChanged" Margin="0,0,0,8"/>
                    <TextBlock Text="Rotation (degrees, any angle)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairRotationBox" Text="0" Padding="5" Margin="0,0,0,7"
                             TextChanged="StairSettingsChanged"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Rotate −15°" Click="RotateStairLeft_Click"
                                Padding="7,4" Margin="0,0,7,0"/>
                        <Button Content="Rotate +15°" Click="RotateStairRight_Click"
                                Padding="7,4"/>
                    </WrapPanel>
                    <TextBlock Text="Selected staircase centre X (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairXBox" IsEnabled="False" Padding="5"
                             Margin="0,0,0,8"/>
                    <TextBlock Text="Selected staircase centre Y (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairYBox" IsEnabled="False" Padding="5"
                             Margin="0,0,0,10"/>
                    <Button x:Name="ApplyStairsButton" Content="Apply stair changes"
                            IsEnabled="False" Click="ApplyStairs_Click" Padding="7"
                            Margin="0,0,0,8"/>
                    <TextBlock x:Name="StairValidationText" Foreground="Firebrick"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button x:Name="DeleteStairsButton" Content="Remove selected staircase"
                            IsEnabled="False" Click="DeleteStairs_Click" Padding="7"
                            Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#566579" Margin="0,0,0,17"
                               Text="UP and DOWN stair flights may be stacked at one location. The selector above lets you choose a flight when their footprints overlap; the plan labels both directions separately. Stairwell openings occur in the upper floor of each flight."/>
                    <Separator Margin="0,0,0,12"/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="WallConstructionSection" Header="WALL CONSTRUCTION" IsExpanded="False"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Exterior wall thickness (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="ExteriorWallBox" Text="0.24" Padding="5" Margin="0,0,0,8"/>
                    <TextBlock Text="Interior wall thickness (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="InteriorWallBox" Text="0.12" Padding="5" Margin="0,0,0,8"/>
                    <Button Content="Apply wall thickness" Click="ApplyWallThickness_Click"
                            Padding="7" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#566579"
                               Margin="0,0,0,16"
                               Text="Thickness is measured perpendicular to each wall's existing centre line. Each floor can have different thicknesses. Doors and windows cut through the wall."/>
                    <Separator Margin="0,0,0,12"/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="PerimeterSection" Header="PERIMETER" IsExpanded="True"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <TextBlock x:Name="CornersText" Text="0 corners" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AreaText" Text="Area: —" Margin="0,0,0,8"/>
                    <CheckBox x:Name="HighlightUnassignedCheckBox" Content="Highlight unassigned interior"
                              IsChecked="True" Checked="UnassignedToggleChanged"
                              Unchecked="UnassignedToggleChanged" Margin="0,0,0,8"/>
                    <TextBlock x:Name="UnassignedAreaText" Text="Unassigned area: —"
                               Margin="0,0,0,8" Foreground="#7B550F"/>
                    <TextBlock x:Name="SlabAreaText" Text="Slab area: —" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LengthText" Text="Wall length: —" Margin="0,0,0,16"/>
                    <CheckBox x:Name="SnapCheckBox" Content="Snap to 0.5 m grid" IsChecked="True"
                              Checked="SnapChanged" Unchecked="SnapChanged" Margin="0,0,0,18"/>
                    <Button x:Name="FinishButton" Content="Finish drawing" Click="Finish_Click"
                            Padding="8" Margin="0,0,0,10"/>
                    <Button Content="Remove selected corner" Click="Delete_Click"
                            Padding="8" Margin="0,0,0,14"/>
                    <Separator/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="RoomsSection" Header="ROOMS" IsExpanded="True"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <TextBlock x:Name="RoomsText" Text="0 rooms" Margin="0,0,0,12"/>
                    <TextBlock Text="Selected room" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="RoomNameBox" IsEnabled="False" Padding="7" Margin="0,0,0,10"/>
                    <TextBlock Text="Room type" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="RoomTypeBox" IsEnabled="False" Margin="0,0,0,12" Padding="5">
                        <ComboBoxItem Content="Other"/>
                        <ComboBoxItem Content="Shop"/>
                        <ComboBoxItem Content="Storeroom"/>
                        <ComboBoxItem Content="Workshop"/>
                        <ComboBoxItem Content="Kitchen"/>
                        <ComboBoxItem Content="Living room"/>
                        <ComboBoxItem Content="Bedroom"/>
                        <ComboBoxItem Content="Bathroom"/>
                        <ComboBoxItem Content="Hallway"/>
                        <ComboBoxItem Content="Stairwell"/>
                        <ComboBoxItem Content="Office"/>
                        <ComboBoxItem Content="Dining room"/>
                        <ComboBoxItem Content="Guest room"/>
                        <ComboBoxItem Content="Common room"/>
                        <ComboBoxItem Content="Cellar"/>
                    </ComboBox>
                    <Button x:Name="ApplyRoomButton" Content="Apply room details" IsEnabled="False"
                            Click="ApplyRoom_Click" Padding="8" Margin="0,0,0,10"/>
                    <Button x:Name="DeleteRoomButton" Content="Delete selected room" IsEnabled="False"
                            Click="DeleteRoom_Click" Padding="8" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="WindowsSection" Header="WINDOWS" IsExpanded="False"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Window width (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="WindowWidthBox" Text="1.2" Padding="5" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="ApplyWindowButton" Content="Apply width"
                                Click="ApplyWindow_Click" IsEnabled="False"
                                Padding="6,4" Margin="0,0,6,0"/>
                        <Button x:Name="DeleteWindowButton" Content="Delete window"
                                Click="DeleteWindow_Click" IsEnabled="False" Padding="6,4"/>
                    </WrapPanel>
                    <Button x:Name="CentreWindowButton" Content="Centre window on room wall segment"
                            IsEnabled="False" Click="CentreWindow_Click" Padding="6,5"
                            Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#566579"
                               Text="Exterior windows are thick cyan with a dark casing. Drag the window line to move it; select it and drag either square endpoint to resize. Windows snap to the 0.5 m grid when enabled. Hold Shift while dragging to temporarily disable snapping. Centre window uses the adjacent room wall where defined, not the entire perimeter."
                               Margin="0,0,0,14"/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="DoorsSection" Header="DOORS" IsExpanded="False"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Door width (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="DoorWidthBox" Text="0.9" Padding="5" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="ApplyDoorButton" Content="Apply width" IsEnabled="False"
                                Click="ApplyDoor_Click" Padding="6,4" Margin="0,0,6,0"/>
                        <Button x:Name="DeleteDoorButton" Content="Delete door" IsEnabled="False"
                                Click="DeleteDoor_Click" Padding="6,4"/>
                    </WrapPanel>
                    <CheckBox x:Name="SecretDoorCheckBox" Content="Secret door" IsEnabled="False"
                              Checked="SecretDoorChanged" Unchecked="SecretDoorChanged"
                              Margin="0,0,0,6"/>
                    <CheckBox x:Name="RevealedDoorCheckBox" Content="Revealed to players" IsEnabled="False"
                              Checked="SecretDoorChanged" Unchecked="SecretDoorChanged"
                              Margin="0,0,0,10"/>
                    <Button x:Name="CentreDoorButton" Content="Centre door on wall segment"
                            IsEnabled="False" Click="CentreDoor_Click" Padding="6,5"
                            Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#566579" Margin="0,0,0,14"
                               Text="In Select / Edit, drag a door's centre marker to move it along any wall. Select it, then drag either square endpoint to resize with the opposite end fixed. Door widths can also be entered above. Centre door positions the opening at the midpoint of its current wall segment."/>
                    <Separator/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="HelpSection" Header="HOW TO USE" IsExpanded="False"
                              Margin="0,0,0,7" Padding="0,3,0,0">
                        <StackPanel Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Draw Perimeter creates or replaces the entire exterior. For an existing building, use Split Perimeter instead of redrawing."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Split Perimeter adds a corner to an exterior wall. Remove Corner merges its two adjacent wall segments. Both tools support angled walls."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Draw Room outlines new spaces. Split Room cuts a selected room between two boundary points. Merge Rooms combines two adjoining rooms: click the first room, then the second."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Move Wall drags a connected straight wall run. Exterior walls carry coincident room boundaries and their doors/windows along. Dragging a perimeter corner also updates attached room vertices between corners. Use Shift to bypass snap while adjusting corners."/>
                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="#566579"
                               Text="Stairwell slab openings and translucent adjacent-floor references are supported. Structural beams, real 3D floor thickness, furniture and automatic generation are future milestones."/>

                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Background="#FFFFFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="WorkingFloorNavigationBar" Grid.Row="0"
                        Background="#E7EEF9" Padding="9,6">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock x:Name="WorkingFloorCountText" FontWeight="Bold"
                                   Text="WORKING BUILDING — 1 FLOOR"
                                   VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="Previous floor" Click="PreviousWorkingFloor_Click"
                                Padding="8,5" Margin="0,0,7,0"/>
                        <ComboBox x:Name="WorkingFloorPicker" MinWidth="185"
                                  SelectionChanged="WorkingFloorPicker_SelectionChanged"
                                  Padding="4" Margin="0,0,7,0"/>
                        <Button Content="Next floor" Click="NextWorkingFloor_Click"
                                Padding="8,5"/>
                        <TextBlock x:Name="EditableFloorHint" Text="Select / Edit to change rooms"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </WrapPanel>
                </Border>
                <Grid Grid.Row="1">
                    <local:FloorPlanSurface x:Name="EditorSurface"/>
                    <!-- The draft is deliberately read-only. Accept commits all
                         levels, collapses this overlay and exposes the editor. -->
                    <Grid x:Name="WholeBuildingPreviewPanel" Visibility="Collapsed"
                          Background="White" Panel.ZIndex="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#E8F2EB" Padding="10">
                            <StackPanel>
                                <TextBlock x:Name="ProposedBuildingHeader" FontWeight="Bold"
                                           Text="PROPOSED BUILDING — NOT YET ACCEPTED"/>
                                <TextBlock Text="Browse every proposed floor below. The plan is read-only until you accept the draft."
                                           TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <WrapPanel>
                                    <Button Content="Previous floor" Click="PreviousProposalFloor_Click"
                                            Padding="8,5" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ProposalFloorPicker" MinWidth="180"
                                              SelectionChanged="ProposalFloorPicker_SelectionChanged"
                                              Padding="5" Margin="0,0,8,0"/>
                                    <Button Content="Next floor" Click="NextProposalFloor_Click"
                                            Padding="8,5" Margin="0,0,15,0"/>
                                    <Button Content="Accept all proposed floors" Click="AcceptSuggestion_Click"
                                            Padding="8,5" Margin="0,0,8,0"/>
                                    <Button Content="Discard preview" Click="DiscardSuggestion_Click"
                                            Padding="8,5"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <local:FloorPlanSurface x:Name="WholeBuildingPreviewSurface"
                                                 Grid.Row="1" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
