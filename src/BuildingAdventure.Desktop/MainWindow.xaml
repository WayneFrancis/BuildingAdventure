<Window x:Class="BuildingAdventure.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildingAdventure.Desktop.Controls"
        Title="BuildingAdventure" Width="1250" Height="820"
        MinWidth="850" MinHeight="560" WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Click="SaveAs_Click" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenu" Header="_Undo" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="RedoMenu" Header="_Redo" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Delete selected corner" Click="Delete_Click" InputGestureText="Delete"/>
                <MenuItem Header="Cancel drawing" Click="Cancel_Click" InputGestureText="Esc"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Fit to window" Click="Fit_Click" InputGestureText="Ctrl+0"/>
                <MenuItem Header="Zoom in" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom out" Click="ZoomOut_Click"/>
            </MenuItem>
        </Menu>
        <ToolBar DockPanel.Dock="Top" Background="#F0F2F5">
            <Button Content="New" Click="New_Click" Padding="9,4"/>
            <Button Content="Open" Click="Open_Click" Padding="9,4"/>
            <Button Content="Save" Click="Save_Click" Padding="9,4"/>
            <Separator/>
            <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Padding="9,4"/>
            <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" Padding="9,4"/>
            <Separator/>
            <Button x:Name="SelectButton" Content="Select / Edit" Click="SelectTool_Click" Padding="9,4"/>
            <Button x:Name="DrawButton" Content="Draw Perimeter" Click="DrawTool_Click" Padding="9,4"/>
            <Button x:Name="PanButton" Content="Pan" Click="PanTool_Click" Padding="9,4"/>
            <Separator/>
            <Button Content="Fit" Click="Fit_Click" Padding="9,4"/>
            <Button Content="+" Click="ZoomIn_Click" Padding="9,4"/>
            <Button Content="−" Click="ZoomOut_Click" Padding="9,4"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom" Background="#E9EDF2">
            <StatusBarItem>
                <TextBlock x:Name="HintText" Text="Ready."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="100%" />
            </StatusBarItem>
        </StatusBar>
        <Border DockPanel.Dock="Right" Width="286" Background="#F7F8FA"
                BorderBrush="#D9DEE6" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <TextBlock Text="BUILDING" FontSize="12" FontWeight="Bold" Foreground="#566579"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Building name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" Text="Untitled Building" TextChanged="NameBox_TextChanged"
                             Padding="7" Margin="0,0,0,20"/>
                    <TextBlock Text="PERIMETER" FontSize="12" FontWeight="Bold" Foreground="#566579"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="CornersText" Text="0 corners" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AreaText" Text="Area: —" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LengthText" Text="Wall length: —" Margin="0,0,0,16"/>
                    <CheckBox x:Name="SnapCheckBox" Content="Snap to 0.5 m grid" IsChecked="True"
                              Checked="SnapChanged" Unchecked="SnapChanged" Margin="0,0,0,18"/>
                    <Button x:Name="FinishButton" Content="Finish perimeter" Click="Finish_Click"
                            Padding="8" Margin="0,0,0,10"/>
                    <Button Content="Delete selected corner" Click="Delete_Click"
                            Padding="8" Margin="0,0,0,24"/>
                    <Separator/>
                    <TextBlock Text="HOW TO USE" FontSize="12" FontWeight="Bold" Foreground="#566579"
                               Margin="0,14,0,12"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Draw Perimeter: click each corner, then click the first corner or double-click to close. Angled walls are fully supported."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Select / Edit: drag a blue corner to move it. Double-click a wall to insert a new corner. Select a corner and press Delete to remove it."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Pan: drag with the middle mouse button, or select the Pan tool and left-drag. Use the mouse wheel to zoom around the pointer."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Hold Shift while placing or moving corners to temporarily disable snapping. Esc cancels an unfinished perimeter."/>
                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="#566579"
                               Text="Rooms, stairs, furnishings and multi-floor generation are planned for later milestones."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Background="#FFFFFF">
            <local:FloorPlanSurface x:Name="EditorSurface"/>
        </Border>
    </DockPanel>
</Window>
