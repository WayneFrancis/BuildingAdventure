<Window x:Class="BuildingAdventure.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildingAdventure.Desktop.Controls"
        Title="BuildingAdventure" Width="1250" Height="820"
        MinWidth="850" MinHeight="560" WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Click="SaveAs_Click" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenu" Header="_Undo" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="RedoMenu" Header="_Redo" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Remove selected corner (join walls)" Click="Delete_Click" InputGestureText="Delete"/>
                <MenuItem Header="Delete selected room" Click="DeleteRoom_Click"/>
                <MenuItem Header="Delete selected door" Click="DeleteDoor_Click"/>
                <MenuItem Header="Cancel drawing" Click="Cancel_Click" InputGestureText="Esc"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Fit to window" Click="Fit_Click" InputGestureText="Ctrl+0"/>
                <MenuItem Header="Zoom in" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom out" Click="ZoomOut_Click"/>
            </MenuItem>
        </Menu>
        <ToolBar DockPanel.Dock="Top" Background="#F0F2F5">
            <Button Content="New" Click="New_Click" Padding="9,4"/>
            <Button Content="Open" Click="Open_Click" Padding="9,4"/>
            <Button Content="Save" Click="Save_Click" Padding="9,4"/>
            <Separator/>
            <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Padding="9,4"/>
            <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" Padding="9,4"/>
            <Separator/>
            <Button x:Name="SelectButton" Content="Select / Edit" Click="SelectTool_Click" Padding="9,4"/>
            <Button x:Name="DrawButton" Content="Draw Perimeter" Click="DrawTool_Click" Padding="9,4"/>
            <Button x:Name="SplitButton" Content="Split Perimeter" Click="SplitPerimeter_Click" Padding="9,4"/>
            <Button x:Name="RemoveCornerButton" Content="Remove Corner" Click="RemoveCornerTool_Click" Padding="9,4"/>
            <Button x:Name="RoomButton" Content="Draw Room" Click="RoomTool_Click" Padding="9,4"/>
            <Button x:Name="SplitRoomButton" Content="Split Room" Click="SplitRoomTool_Click" Padding="9,4"/>
            <Button x:Name="MergeRoomsButton" Content="Merge Rooms" Click="MergeRoomsTool_Click" Padding="9,4"/>
            <Button x:Name="MoveWallButton" Content="Move Wall" Click="MoveWallTool_Click" Padding="9,4"/>
            <Button x:Name="DoorButton" Content="Add Door" Click="DoorTool_Click" Padding="9,4"/>
            <Button x:Name="PlaceStairsButton" Content="Place Stairs" Click="PlaceStairsTool_Click" Padding="9,4"/>
            <Button x:Name="PanButton" Content="Pan" Click="PanTool_Click" Padding="9,4"/>
            <Separator/>
            <Button Content="Fit" Click="Fit_Click" Padding="9,4"/>
            <Button Content="+" Click="ZoomIn_Click" Padding="9,4"/>
            <Button Content="−" Click="ZoomOut_Click" Padding="9,4"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom" Background="#E9EDF2">
            <StatusBarItem>
                <TextBlock x:Name="HintText" Text="Ready."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="100%" />
            </StatusBarItem>
        </StatusBar>
        <Border DockPanel.Dock="Right" Width="286" Background="#F7F8FA"
                BorderBrush="#D9DEE6" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <TextBlock Text="BUILDING" FontSize="12" FontWeight="Bold" Foreground="#566579"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Building name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" Text="Untitled Building" TextChanged="NameBox_TextChanged"
                             Padding="7" Margin="0,0,0,14"/>
                    <TextBlock Text="FLOORS" FontSize="12" FontWeight="Bold" Foreground="#566579"
                               Margin="0,0,0,10"/>
                    <ComboBox x:Name="FloorPicker" SelectionChanged="FloorPicker_SelectionChanged"
                              Padding="5" Margin="0,0,0,9"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="AddFloorButton" Content="Add Floor" Click="AddFloor_Click"
                                Padding="7,5" Margin="0,0,7,0"/>
                        <Button x:Name="RemoveFloorButton" Content="Remove Top Floor"
                                Click="RemoveFloor_Click" Padding="7,5"/>
                    </WrapPanel>
                    <TextBlock Text="STAIRCASES" FontSize="12" FontWeight="Bold"
                               Foreground="#566579" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StairsText" Text="0 stair flights" Margin="0,0,0,8"/>
                    <TextBlock Text="Length (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairLengthBox" Text="3.6" Padding="5" Margin="0,0,0,8"
                             TextChanged="StairSettingsChanged"/>
                    <TextBlock Text="Width (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairWidthBox" Text="1.4" Padding="5" Margin="0,0,0,8"
                             TextChanged="StairSettingsChanged"/>
                    <TextBlock Text="Rotation (degrees, any angle)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairRotationBox" Text="0" Padding="5" Margin="0,0,0,7"
                             TextChanged="StairSettingsChanged"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Rotate −15°" Click="RotateStairLeft_Click"
                                Padding="7,4" Margin="0,0,7,0"/>
                        <Button Content="Rotate +15°" Click="RotateStairRight_Click"
                                Padding="7,4"/>
                    </WrapPanel>
                    <TextBlock Text="Selected staircase centre X (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairXBox" IsEnabled="False" Padding="5"
                             Margin="0,0,0,8"/>
                    <TextBlock Text="Selected staircase centre Y (m)" Margin="0,0,0,4"/>
                    <TextBox x:Name="StairYBox" IsEnabled="False" Padding="5"
                             Margin="0,0,0,10"/>
                    <Button x:Name="ApplyStairsButton" Content="Apply stair changes"
                            IsEnabled="False" Click="ApplyStairs_Click" Padding="7"
                            Margin="0,0,0,8"/>
                    <TextBlock x:Name="StairValidationText" Foreground="Firebrick"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button x:Name="DeleteStairsButton" Content="Remove selected staircase"
                            IsEnabled="False" Click="DeleteStairs_Click" Padding="7"
                            Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#566579" Margin="0,0,0,17"
                               Text="Place Stairs shows a green/red preview. Click to place, then drag stairs in Select / Edit to reposition. Select stairs to edit dimensions, angle or X/Y coordinates. Shift bypasses grid snapping."/>
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock Text="PERIMETER" FontSize="12" FontWeight="Bold" Foreground="#566579"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="CornersText" Text="0 corners" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AreaText" Text="Area: —" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LengthText" Text="Wall length: —" Margin="0,0,0,16"/>
                    <CheckBox x:Name="SnapCheckBox" Content="Snap to 0.5 m grid" IsChecked="True"
                              Checked="SnapChanged" Unchecked="SnapChanged" Margin="0,0,0,18"/>
                    <Button x:Name="FinishButton" Content="Finish drawing" Click="Finish_Click"
                            Padding="8" Margin="0,0,0,10"/>
                    <Button Content="Remove selected corner" Click="Delete_Click"
                            Padding="8" Margin="0,0,0,14"/>
                    <Separator/>
                    <TextBlock Text="ROOMS" FontSize="12" FontWeight="Bold" Foreground="#566579"
                               Margin="0,12,0,12"/>
                    <TextBlock x:Name="RoomsText" Text="0 rooms" Margin="0,0,0,12"/>
                    <TextBlock Text="Selected room" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="RoomNameBox" IsEnabled="False" Padding="7" Margin="0,0,0,10"/>
                    <TextBlock Text="Room type" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="RoomTypeBox" IsEnabled="False" Margin="0,0,0,12" Padding="5">
                        <ComboBoxItem Content="Other"/>
                        <ComboBoxItem Content="Shop"/>
                        <ComboBoxItem Content="Storeroom"/>
                        <ComboBoxItem Content="Workshop"/>
                        <ComboBoxItem Content="Kitchen"/>
                        <ComboBoxItem Content="Living room"/>
                        <ComboBoxItem Content="Bedroom"/>
                        <ComboBoxItem Content="Bathroom"/>
                        <ComboBoxItem Content="Hallway"/>
                        <ComboBoxItem Content="Stairwell"/>
                        <ComboBoxItem Content="Office"/>
                        <ComboBoxItem Content="Dining room"/>
                        <ComboBoxItem Content="Guest room"/>
                        <ComboBoxItem Content="Common room"/>
                        <ComboBoxItem Content="Cellar"/>
                    </ComboBox>
                    <Button x:Name="ApplyRoomButton" Content="Apply room details" IsEnabled="False"
                            Click="ApplyRoom_Click" Padding="8" Margin="0,0,0,10"/>
                    <Button x:Name="DeleteRoomButton" Content="Delete selected room" IsEnabled="False"
                            Click="DeleteRoom_Click" Padding="8" Margin="0,0,0,10"/>
                    <Button x:Name="DeleteDoorButton" Content="Delete selected door" IsEnabled="False"
                            Click="DeleteDoor_Click" Padding="8" Margin="0,0,0,14"/>
                    <Separator/>
                    <TextBlock Text="HOW TO USE" FontSize="12" FontWeight="Bold" Foreground="#566579"
                               Margin="0,14,0,12"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Draw Perimeter creates or replaces the entire exterior. For an existing building, use Split Perimeter instead of redrawing."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Split Perimeter adds a corner to an exterior wall. Remove Corner merges its two adjacent wall segments. Both tools support angled walls."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Draw Room outlines new spaces. Split Room cuts a selected room between two boundary points. Merge Rooms combines two adjoining rooms: click the first room, then the second."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Move Wall drags an entire wall. In Select / Edit, dragging a corner snaps to nearby corners or wall edges; hold Shift for precise unsnapped placement. Add Door inserts a 0.9 m doorway."/>
                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="#566579"
                               Text="Floors 1–4 and linked stair footprints are supported. Stair reservations are overlays, not automatically carved stairwell rooms. Furniture and automatic generation are future milestones."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Background="#FFFFFF">
            <local:FloorPlanSurface x:Name="EditorSurface"/>
        </Border>
    </DockPanel>
</Window>
